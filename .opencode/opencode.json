{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "job-assist",
  "agent": {
    "job-assist": {
      "description": "Interpret JobTelemetry after wrap; write assist/job.json; never mutate SLURM"
    }
  },
  "permission": {
    "question": "deny",
    "bash": "deny",
    "skill": "deny",
    "webfetch": "deny",
    "external_directory": {
      "/shared/agent-runs/**": "allow",
      "**/agent-runs/**": "allow"
    }
  }
}
